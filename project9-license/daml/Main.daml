module Main where

import DA.Time

template License
  with
    issuer    : Party
    holder    : Party
    licenseId : Text
    issuedAt  : Time
    expiresAt : Time
  where
    signatory issuer
    observer holder

    -- Reject invalid state at creation time
    ensure issuer /= holder
         && licenseId /= ""
         && expiresAt > issuedAt

    -- Check if license is still valid
    nonconsuming choice IsValid : Bool
      controller holder
      do
        now <- getTime
        return (now < expiresAt)

    -- Renew the license by extending expiry
    choice Renew : ContractId License
      with extraDays : Int
      controller issuer
      do
        -- Only positive extensions are allowed; never shrink the expiry
        assertMsg "extraDays must be positive" (extraDays > 0)
        now <- getTime
        -- Extend from whichever is later: now or the current expiry, 
        -- so an already-expired license is renewed forward from now.
        let base = if now > expiresAt then now else expiresAt
        let newExpiry = addRelTime base (days extraDays)
        create this with
          expiresAt = newExpiry

    -- Revoke license before expiry
    choice Revoke : ()
      controller issuer
      do return ()
