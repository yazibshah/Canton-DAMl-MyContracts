module Test where

import Daml.Script
import Main

-- Test 1: Full flow — Optional delegate, split, deposit
test_delegate_flow : Script ()
test_delegate_flow = script do

  bank  <- allocatePartyByHint (PartyIdHint "Bank")
  sara  <- allocatePartyByHint (PartyIdHint "Sara")
  yazib <- allocatePartyByHint (PartyIdHint "Yazib")
  ali   <- allocatePartyByHint (PartyIdHint "Ali")

  -- Sara's account: no delegate yet (None)
  saraAcc1 <- submit bank do
    createCmd Account with
      bank = bank
      owner = sara
      balance = 100000.0
      delegate = None
      delegateLimit = None

  -- Ali's account
  aliAcc1 <- submit bank do
    createCmd Account with
      bank = bank
      owner = ali
      balance = 5000.0
      delegate = None
      delegateLimit = None

  -- Check: no delegate
  has1 <- submit sara do exerciseCmd saraAcc1 HasDelegate
  assertMsg "Should have no delegate" (has1 == False)
  info1 <- submit sara do exerciseCmd saraAcc1 GetDelegateInfo
  debug info1

  -- Sara sets Yazib as delegate (None -> Some)
  saraAcc2 <- submit sara do
    exerciseCmd saraAcc1 SetDelegate with
      agent = yazib
      maxAmount = 50000.0

  has2 <- submit sara do exerciseCmd saraAcc2 HasDelegate
  assertMsg "Should have delegate" (has2 == True)
  info2 <- submit sara do exerciseCmd saraAcc2 GetDelegateInfo
  debug info2

  -- Yazib sends 30000 from Sara's account to Ali (tuple return!)
  (saraAcc3, payId) <- submit yazib do
    exerciseCmd saraAcc2 DelegatedTransfer with
      actor = yazib
      recipient = ali
      amount = 30000.0

  -- Sara's balance really went down
  Some s <- queryContractId bank saraAcc3
  assertMsg "Sara has 70000" (s.balance == 70000.0)
  debug ("Sara balance: " <> show s.balance)

  -- Payment records who authorized it
  Some p <- queryContractId bank payId
  assertMsg "Authorized by Yazib" (p.authorizedBy == yazib)
  assertMsg "Sender is Sara" (p.sender == sara)

  -- Ali deposits the payment
  aliAcc2 <- submit ali do
    exerciseCmd payId DepositTo with accountCid = aliAcc1

  Some a <- queryContractId bank aliAcc2
  assertMsg "Ali has 35000" (a.balance == 35000.0)
  debug ("Ali balance: " <> show a.balance)

  -- Cannot deposit the same payment twice
  submitMustFail ali do
    exerciseCmd payId DepositTo with accountCid = aliAcc2

  return ()


-- Test 2: Limit and wrong actor
test_delegate_rules : Script ()
test_delegate_rules = script do

  bank  <- allocatePartyByHint (PartyIdHint "Bank")
  sara  <- allocatePartyByHint (PartyIdHint "Sara")
  yazib <- allocatePartyByHint (PartyIdHint "Yazib")
  ali   <- allocatePartyByHint (PartyIdHint "Ali")

  saraAcc1 <- submit bank do
    createCmd Account with
      bank = bank
      owner = sara
      balance = 100000.0
      delegate = None
      delegateLimit = None

  saraAcc2 <- submit sara do
    exerciseCmd saraAcc1 SetDelegate with
      agent = yazib
      maxAmount = 50000.0

  -- Over the limit -> fails
  submitMustFail yazib do
    exerciseCmd saraAcc2 DelegatedTransfer with
      actor = yazib
      recipient = ali
      amount = 80000.0

  -- Ali is not the delegate -> fails
  submitMustFail ali do
    exerciseCmd saraAcc2 DelegatedTransfer with
      actor = ali
      recipient = ali
      amount = 1000.0

  debug "Limit and wrong-actor checks work"
  return ()


-- Test 3: Remove delegate (Some -> None)
test_remove_delegate : Script ()
test_remove_delegate = script do

  bank  <- allocatePartyByHint (PartyIdHint "Bank")
  sara  <- allocatePartyByHint (PartyIdHint "Sara")
  yazib <- allocatePartyByHint (PartyIdHint "Yazib")
  ali   <- allocatePartyByHint (PartyIdHint "Ali")

  saraAcc1 <- submit bank do
    createCmd Account with
      bank = bank
      owner = sara
      balance = 100000.0
      delegate = None
      delegateLimit = None

  saraAcc2 <- submit sara do
    exerciseCmd saraAcc1 SetDelegate with
      agent = yazib
      maxAmount = 50000.0

  saraAcc3 <- submit sara do
    exerciseCmd saraAcc2 RemoveDelegate

  -- Yazib can no longer act
  submitMustFail yazib do
    exerciseCmd saraAcc3 DelegatedTransfer with
      actor = yazib
      recipient = ali
      amount = 1000.0

  info <- submit sara do exerciseCmd saraAcc3 GetDelegateInfo
  debug info   -- "No delegate"

  return ()


-- Test 4: Owner transfers directly (tuple return)
test_owner_transfer : Script ()
test_owner_transfer = script do

  bank <- allocatePartyByHint (PartyIdHint "Bank")
  sara <- allocatePartyByHint (PartyIdHint "Sara")
  ali  <- allocatePartyByHint (PartyIdHint "Ali")

  saraAcc1 <- submit bank do
    createCmd Account with
      bank = bank
      owner = sara
      balance = 20000.0
      delegate = None
      delegateLimit = None

  (saraAcc2, payId) <- submit sara do
    exerciseCmd saraAcc1 Transfer with
      recipient = ali
      amount = 5000.0

  Some s <- queryContractId bank saraAcc2
  assertMsg "Sara has 15000" (s.balance == 15000.0)

  Some p <- queryContractId ali payId
  assertMsg "Ali sees 5000 payment" (p.amount == 5000.0)

  return ()
